# DataForSEO — research only. Never prefix with NEXT_PUBLIC_.
# Copy to .env.local (gitignored) and fill in from the DataForSEO dashboard.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# WhatsApp handoff number (full international number, digits only, e.g. 18085551234).
# Public by design (inlined into the client). Leave blank to hide WhatsApp CTAs
# and keep the quote form as the only path — we never ship a fabricated number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
